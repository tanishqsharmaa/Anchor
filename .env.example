# PROJECT ANCHOR Environment Template
# Copy this file to .env and configure your sovereign parameters.

ANCHOR_ENVIRONMENT="development"
ANCHOR_DEBUG="false"

# Local Sovereign LLM Configuration
ANCHOR_OLLAMA_BASE_URL="http://localhost:11434"
ANCHOR_OLLAMA_MODEL="qwen2.5:7b-instruct-q4_K_M"

# OpenVINO Hardware Inference Device ("CPU", "GPU", "NPU", "AUTO")
ANCHOR_OPENVINO_DEVICE="AUTO"
ANCHOR_MAX_RAM_GB="12.5"

# Verification & Gating Thresholds
ANCHOR_NLI_ENTAILMENT_THRESHOLD="0.85"
ANCHOR_NLI_CONTRADICTION_THRESHOLD="0.08"
ANCHOR_CORRECTIVE_GATE_SIMILARITY_MIN="0.65"
